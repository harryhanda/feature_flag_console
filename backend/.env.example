# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string. Use the `featureflags` database.
# Get <db_password> from your MongoDB Atlas cluster user; never hardcode it in source.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/featureflags?appName=FeatureFlagCluster

# A long, random secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret

# Port the backend listens on
PORT=5001

# Origin of the React admin dashboard (for CORS)
FRONTEND_URL=http://localhost:3000

# Origin the demo client is served from (for CORS)
DEMO_CLIENT_URL=http://localhost:5500

# development | production
NODE_ENV=development
